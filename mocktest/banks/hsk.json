{"id": "hsk", "title": "HSK (China)", "desc": {"id": "HSK 1, 2 & 3: 听力 Listening, 阅读 Reading, 书写 Writing (HSK 3). Soal latihan buatan TEG sesuai format HSK.", "en": "HSK 1, 2 & 3: Listening, Reading, Writing (HSK 3). TEG practice items in HSK format."}, "sections": [{"id": "h1l", "title": "HSK 1 · 听力 (Listening)", "minutes": 15, "auto": true, "skill": "H1L", "desc": {"id": "5 percakapan, dengan pinyin.", "en": "5 dialogues, with pinyin."}, "slots": [{"id": "l", "title": "听力", "sets": [{"id": "H1La", "title": "听力 A", "audio": "audio/hsk/H1La.mp3", "instructions": "请听对话，选出正确答案。(audio diputar 1 kali)", "transcript": "<b>第1题。</b><br>女: 你好！你叫什么名字？<br>男: 我叫王明。<br><br><b>第2题。</b><br>男: 你家有几口人？<br>女: 我家有四口人。<br><br><b>第3题。</b><br>女: 今天星期几？<br>男: 今天星期三。<br><br><b>第4题。</b><br>男: 你想喝什么？<br>女: 我想喝茶。<br><br><b>第5题。</b><br>女: 你的书在哪儿？<br>男: 在桌子上。<br>", "questions": [{"type": "mcq", "prompt": "1. 他叫什么名字？(Tā jiào shénme míngzi?)", "options": ["王明 Wáng Míng", "李明 Lǐ Míng", "王月 Wáng Yuè", "张明 Zhāng Míng"], "answer": 0}, {"type": "mcq", "prompt": "2. 她家有几口人？(Tā jiā yǒu jǐ kǒu rén?)", "options": ["四口 sì kǒu", "三口 sān kǒu", "五口 wǔ kǒu", "十口 shí kǒu"], "answer": 0}, {"type": "mcq", "prompt": "3. 今天星期几？(Jīntiān xīngqī jǐ?)", "options": ["星期三 xīngqīsān", "星期一 xīngqīyī", "星期五 xīngqīwǔ", "星期天 xīngqītiān"], "answer": 0}, {"type": "mcq", "prompt": "4. 她想喝什么？(Tā xiǎng hē shénme?)", "options": ["茶 chá", "水 shuǐ", "咖啡 kāfēi", "牛奶 niúnǎi"], "answer": 0}, {"type": "mcq", "prompt": "5. 书在哪儿？(Shū zài nǎr?)", "options": ["桌子上 zhuōzi shang", "椅子下 yǐzi xià", "家里 jiā li", "学校 xuéxiào"], "answer": 0}]}, {"id": "H1Lb", "title": "听力 B", "audio": "audio/hsk/H1Lb.mp3", "instructions": "请听对话，选出正确答案。(audio diputar 1 kali)", "transcript": "<b>第1题。</b><br>男: 现在几点？<br>女: 现在八点。<br><br><b>第2题。</b><br>女: 你是哪国人？<br>男: 我是中国人。<br><br><b>第3题。</b><br>男: 明天你去哪儿？<br>女: 我去商店买东西。<br><br><b>第4题。</b><br>女: 这个杯子多少钱？<br>男: 十五块。<br><br><b>第5题。</b><br>男: 你会做中国菜吗？<br>女: 会，我会做很多中国菜。<br>", "questions": [{"type": "mcq", "prompt": "1. 现在几点？(Xiànzài jǐ diǎn?)", "options": ["八点 bā diǎn", "九点 jiǔ diǎn", "十点 shí diǎn", "七点 qī diǎn"], "answer": 0}, {"type": "mcq", "prompt": "2. 他是哪国人？(Tā shì nǎ guó rén?)", "options": ["中国人 Zhōngguó rén", "美国人 Měiguó rén", "日本人 Rìběn rén", "印度尼西亚人 Yìndùníxīyà rén"], "answer": 0}, {"type": "mcq", "prompt": "3. 她明天去哪儿？(Tā míngtiān qù nǎr?)", "options": ["商店 shāngdiàn", "医院 yīyuàn", "学校 xuéxiào", "饭店 fàndiàn"], "answer": 0}, {"type": "mcq", "prompt": "4. 杯子多少钱？(Bēizi duōshao qián?)", "options": ["15块 shíwǔ kuài", "50块 wǔshí kuài", "5块 wǔ kuài", "10块 shí kuài"], "answer": 0}, {"type": "mcq", "prompt": "5. 她会做中国菜吗？(Tā huì zuò Zhōngguó cài ma?)", "options": ["会 huì", "不会 bú huì", "不想 bù xiǎng", "不知道 bù zhīdào"], "answer": 0}]}]}], "score": {"type": "pct", "label": "Benar"}}, {"id": "h1r", "title": "HSK 1 · 阅读 (Reading)", "minutes": 17, "auto": true, "skill": "H1R", "desc": {"id": "6 soal dengan pinyin.", "en": "6 items with pinyin."}, "slots": [{"id": "r", "title": "阅读", "sets": [{"id": "H1R", "title": "阅读", "instructions": "选出最合适的回答或词语。(Pilih jawaban / kata yang paling tepat.)", "questions": [{"type": "mcq", "prompt": "你喜欢吃什么？<br><small>Nǐ xǐhuan chī shénme?</small>", "options": ["我喜欢吃米饭。", "我在北京。", "他是老师。", "今天很冷。"], "answer": 0, "group": "选出合适的回答"}, {"type": "mcq", "prompt": "你女儿几岁了？<br><small>Nǐ nǚ'ér jǐ suì le?</small>", "options": ["她七岁了。", "她是学生。", "她在家。", "她叫小月。"], "answer": 0, "group": "选出合适的回答"}, {"type": "mcq", "prompt": "你在做什么呢？<br><small>Nǐ zài zuò shénme ne?</small>", "options": ["我在看书。", "我叫小王。", "我有三本书。", "我不去。"], "answer": 0, "group": "选出合适的回答"}, {"type": "mcq", "prompt": "谢谢你！<br><small>Xièxie nǐ!</small>", "options": ["不客气。", "没关系。", "再见。", "你好。"], "answer": 0, "group": "选出合适的回答"}, {"type": "mcq", "prompt": "我（　）北京大学的学生。<br><small>Wǒ (　) Běijīng Dàxué de xuésheng.</small>", "options": ["是 shì", "有 yǒu", "在 zài", "去 qù"], "answer": 0, "group": "选词填空"}, {"type": "mcq", "prompt": "他（　）医院工作。<br><small>Tā (　) yīyuàn gōngzuò.</small>", "options": ["在 zài", "是 shì", "有 yǒu", "叫 jiào"], "answer": 0, "group": "选词填空"}]}]}], "score": {"type": "pct", "label": "Benar"}}, {"id": "h2l", "title": "HSK 2 · 听力 (Listening)", "minutes": 25, "auto": true, "skill": "H2L", "desc": {"id": "5 percakapan.", "en": "5 dialogues."}, "slots": [{"id": "l", "title": "听力", "sets": [{"id": "H2La", "title": "听力 A", "audio": "audio/hsk/H2La.mp3", "instructions": "请听对话，选出正确答案。(audio diputar 1 kali)", "transcript": "<b>第1题。</b><br>男: 你是怎么来的？<br>女: 我是坐出租车来的。<br><br><b>第2题。</b><br>女: 你哥哥比你大几岁？<br>男: 他比我大三岁。<br><br><b>第3题。</b><br>男: 外面下雨了吗？<br>女: 没有，但是天阴了，你带上伞吧。<br><br><b>第4题。</b><br>女: 你的手机呢？<br>男: 在房间里，我去拿。<br><br><b>第5题。</b><br>男: 这件衣服太贵了，有便宜一点儿的吗？<br>女: 这件是三百块，那件两百块。<br>", "questions": [{"type": "mcq", "prompt": "1. 女的是怎么来的？", "options": ["坐出租车", "坐公共汽车", "坐飞机", "走路"], "answer": 0}, {"type": "mcq", "prompt": "2. 哥哥比他大几岁？", "options": ["三岁", "两岁", "四岁", "一岁"], "answer": 0}, {"type": "mcq", "prompt": "3. 现在天气怎么样？", "options": ["阴天", "下雨", "晴天", "下雪"], "answer": 0}, {"type": "mcq", "prompt": "4. 手机在哪儿？", "options": ["房间里", "桌子上", "学校里", "车上"], "answer": 0}, {"type": "mcq", "prompt": "5. 便宜的衣服多少钱？", "options": ["两百块", "三百块", "一百块", "五百块"], "answer": 0}]}, {"id": "H2Lb", "title": "听力 B", "audio": "audio/hsk/H2Lb.mp3", "instructions": "请听对话，选出正确答案。(audio diputar 1 kali)", "transcript": "<b>第1题。</b><br>女: 你每天几点起床？<br>男: 六点半，因为我七点要去跑步。<br><br><b>第2题。</b><br>男: 你会说汉语吗？<br>女: 会一点儿，我学了半年了。<br><br><b>第3题。</b><br>女: 医生说你要多休息。<br>男: 好的，我这几天不去公司了。<br><br><b>第4题。</b><br>男: 我们几号去旅游？<br>女: 下个月五号，坐飞机去。<br><br><b>第5题。</b><br>女: 你喜欢什么运动？<br>男: 我最喜欢踢足球。<br>", "questions": [{"type": "mcq", "prompt": "1. 他几点去跑步？", "options": ["七点", "六点半", "六点", "七点半"], "answer": 0}, {"type": "mcq", "prompt": "2. 她学汉语多长时间了？", "options": ["半年", "一年", "两年", "三个月"], "answer": 0}, {"type": "mcq", "prompt": "3. 男的怎么了？", "options": ["生病了", "很忙", "要去旅游", "找工作"], "answer": 0}, {"type": "mcq", "prompt": "4. 他们什么时候去旅游？", "options": ["下个月五号", "这个月五号", "下个月十五号", "下星期五"], "answer": 0}, {"type": "mcq", "prompt": "5. 男的最喜欢什么运动？", "options": ["足球", "篮球", "游泳", "跑步"], "answer": 0}]}]}], "score": {"type": "pct", "label": "Benar"}}, {"id": "h2r", "title": "HSK 2 · 阅读 (Reading)", "minutes": 22, "auto": true, "skill": "H2R", "desc": {"id": "6 soal termasuk bacaan pendek.", "en": "6 items incl. a short text."}, "slots": [{"id": "r", "title": "阅读", "sets": [{"id": "H2R", "title": "阅读", "instructions": "选出最合适的回答或词语。(Pilih jawaban / kata yang paling tepat.)", "passage": "<p>小李每天早上七点起床，七点半吃早饭，八点坐公共汽车去公司。他的公司离家不远，坐车二十分钟就到了。</p>", "questions": [{"type": "mcq", "prompt": "我们一起去看电影吧。", "options": ["好啊，几点的？", "我没有钱包。", "他是我哥哥。", "不客气。"], "answer": 0, "group": "选出合适的回答"}, {"type": "mcq", "prompt": "你为什么没来上课？", "options": ["因为我生病了。", "我坐公共汽车来的。", "我在教室里。", "我很高兴。"], "answer": 0, "group": "选出合适的回答"}, {"type": "mcq", "prompt": "这个房间（　）那个房间大。", "options": ["比", "跟", "和", "对"], "answer": 0, "group": "选词填空"}, {"type": "mcq", "prompt": "他跑得很（　），每次都是第一。", "options": ["快", "高", "贵", "远"], "answer": 0, "group": "选词填空"}, {"type": "mcq", "prompt": "(短文) 小李几点到公司？", "options": ["八点二十", "八点", "七点半", "九点"], "answer": 0, "explain": "8:00 naik bus + 20 menit = 8:20.", "group": "阅读短文"}, {"type": "mcq", "prompt": "(短文) 小李怎么去公司？", "options": ["坐公共汽车", "坐出租车", "走路", "开车"], "answer": 0, "group": "阅读短文"}]}]}], "score": {"type": "pct", "label": "Benar"}}, {"id": "h3l", "title": "HSK 3 · 听力 (Listening)", "minutes": 35, "auto": true, "skill": "H3L", "desc": {"id": "5 percakapan.", "en": "5 dialogues."}, "slots": [{"id": "l", "title": "听力", "sets": [{"id": "H3La", "title": "听力 A", "audio": "audio/hsk/H3La.mp3", "instructions": "请听对话，选出正确答案。(audio diputar 1 kali)", "transcript": "<b>第1题。</b><br>男: 这次考试你准备得怎么样了？<br>女: 别提了，我最近一直在忙工作，几乎没时间复习。<br><br><b>第2题。</b><br>女: 你周末打算做什么？<br>男: 本来想去爬山，但是天气预报说会下大雨，只好在家看书了。<br><br><b>第3题。</b><br>男: 请问去火车站怎么走？<br>女: 你一直往前走，到第二个路口往左拐，大概走十分钟就到了。<br><br><b>第4题。</b><br>女: 这个冰箱比上次那个贵了五百块。<br>男: 贵是贵了点儿，但是质量好多了。<br><br><b>第5题。</b><br>男: 你姐姐是做什么工作的？<br>女: 她现在在银行上班，以前当过老师。<br>", "questions": [{"type": "mcq", "prompt": "1. 女的是什么意思？", "options": ["她还没准备好", "她准备得很好", "考试已经结束了", "她不想工作了"], "answer": 0}, {"type": "mcq", "prompt": "2. 男的周末可能会做什么？", "options": ["在家看书", "去爬山", "去游泳", "去上班"], "answer": 0}, {"type": "mcq", "prompt": "3. 去火车站应该怎么走？", "options": ["到第二个路口往左拐", "到第一个路口往右拐", "坐地铁去", "到第二个路口往右拐"], "answer": 0}, {"type": "mcq", "prompt": "4. 男的觉得这个冰箱怎么样？", "options": ["质量更好", "太贵了，不买", "和上次的一样", "太小了"], "answer": 0}, {"type": "mcq", "prompt": "5. 女的的姐姐现在做什么工作？", "options": ["在银行工作", "当老师", "当医生", "没有工作"], "answer": 0}]}, {"id": "H3Lb", "title": "听力 B", "audio": "audio/hsk/H3Lb.mp3", "instructions": "请听对话，选出正确答案。(audio diputar 1 kali)", "transcript": "<b>第1题。</b><br>女: 你的汉语说得越来越好了。<br>男: 哪里哪里，我还要多练习。<br><br><b>第2题。</b><br>男: 会议改到几点了？<br>女: 原来是两点，现在推迟一个小时。<br><br><b>第3题。</b><br>女: 我想买一台电脑，你有什么建议？<br>男: 如果你主要用来上网和写文章，不用买太贵的。<br><br><b>第4题。</b><br>男: 这个菜辣不辣？<br>女: 有一点儿辣，不过你可以让服务员少放辣椒。<br><br><b>第5题。</b><br>女: 你怎么又迟到了？<br>男: 对不起，路上堵车堵得厉害。<br>", "questions": [{"type": "mcq", "prompt": "1. 男的是什么意思？", "options": ["他觉得自己还要多练习", "他不想学汉语了", "他说得非常好", "他要去中国"], "answer": 0}, {"type": "mcq", "prompt": "2. 会议现在几点开始？", "options": ["三点", "两点", "一点", "四点"], "answer": 0}, {"type": "mcq", "prompt": "3. 男的建议女的怎么做？", "options": ["买便宜一点儿的", "买最贵的", "不要买电脑", "买手机"], "answer": 0}, {"type": "mcq", "prompt": "4. 根据对话，可以知道什么？", "options": ["可以少放辣椒", "这个菜一点儿也不辣", "这个菜非常辣，不能吃", "服务员不在"], "answer": 0}, {"type": "mcq", "prompt": "5. 男的为什么迟到？", "options": ["堵车", "起晚了", "生病了", "忘了时间"], "answer": 0}]}]}], "score": {"type": "pct", "label": "Benar"}}, {"id": "h3r", "title": "HSK 3 · 阅读 (Reading)", "minutes": 30, "auto": true, "skill": "H3R", "desc": {"id": "6 soal termasuk bacaan.", "en": "6 items incl. reading."}, "slots": [{"id": "r", "title": "阅读", "sets": [{"id": "H3R", "title": "阅读", "instructions": "选出最合适的词语或答案。(Pilih kata / jawaban yang paling tepat.)", "passage": "<p>小王以前很少运动，身体也不太好。后来医生建议他每天走路上班。现在他已经坚持了一年，不但瘦了五公斤，而且很少感冒了。</p>", "questions": [{"type": "cloze", "text": "他[[0]]喜欢唱歌，[[1]]喜欢跳舞。", "blanks": {"0": {"options": ["不但", "虽然", "因为", "如果"], "answer": "不但"}, "1": {"options": ["而且", "但是", "所以", "就"], "answer": "而且"}}, "group": "选词填空", "explain": "不但……而且…… = tidak hanya ... tetapi juga ..."}, {"type": "mcq", "prompt": "我已经把作业（　）了。", "options": ["写完", "写着", "在写", "要写"], "answer": 0, "group": "选词填空"}, {"type": "mcq", "prompt": "外面太冷了，你多穿（　）衣服吧。", "options": ["点儿", "一下", "一次", "一遍"], "answer": 0, "group": "选词填空"}, {"type": "mcq", "prompt": "这件事情很（　），我需要想一想再回答你。", "options": ["重要", "简单", "容易", "便宜"], "answer": 0, "group": "选词填空"}, {"type": "mcq", "prompt": "(短文) 根据这段话，可以知道小王：", "options": ["现在身体比以前好", "现在开车上班", "以前经常运动", "胖了五公斤"], "answer": 0, "group": "阅读短文"}, {"type": "mcq", "prompt": "(短文) 是谁建议小王走路上班的？", "options": ["医生", "妻子", "同事", "老师"], "answer": 0, "group": "阅读短文"}]}]}], "score": {"type": "pct", "label": "Benar"}}, {"id": "h3w", "title": "HSK 3 · 书写 (Writing)", "minutes": 15, "auto": true, "skill": "H3W", "desc": {"id": "Susun kalimat & tulis Hanzi dari pinyin.", "en": "Sentence ordering & writing characters from pinyin."}, "slots": [{"id": "w", "title": "书写", "sets": [{"id": "H3W", "title": "书写", "instructions": "Bagian 1: susun kata menjadi kalimat. Bagian 2: tulis karakter Hanzi sesuai pinyin.", "questions": [{"type": "order", "prompt": "完成句子：把词语排成正确的句子。(Susun menjadi kalimat yang benar.)", "items": ["我", "把", "作业", "写完了"], "explain": "我把作业写完了。"}, {"type": "order", "prompt": "完成句子：把词语排成正确的句子。(Susun menjadi kalimat yang benar.)", "items": ["她", "穿着", "一件", "红色的", "裙子"], "explain": "她穿着一件红色的裙子。"}, {"type": "order", "prompt": "完成句子：把词语排成正确的句子。(Susun menjadi kalimat yang benar.)", "items": ["这个", "问题", "对我来说", "太", "难了"], "explain": "这个问题对我来说太难了。"}, {"type": "gap", "prompt": "今天天气很好，我们去公园 ___（sànbù）吧。", "answer": ["散步"], "explain": "", "group": "看拼音写汉字 (Tulis karakter sesuai pinyin)"}, {"type": "gap", "prompt": "他每天早上喝一杯 ___（niúnǎi）。", "answer": ["牛奶"], "explain": "", "group": "看拼音写汉字 (Tulis karakter sesuai pinyin)"}, {"type": "gap", "p